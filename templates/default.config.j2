# WARNING!! This file is automatically generated and it is
# overridden when on install/update commands.
# Please consider re-running config/install commands rather
# than manually edit this file

ntp=false
ntp.pool=pool.ntp.org
network.id={{ radixnode_network_id }}

node.key.path={{ radixnode_keystore_dir }}/{{ radixnode_keystore_file }}
node.key.create_if_missing=true

network.p2p.broadcast_port={{ radixnode_p2p_broadcast_port }}
network.p2p.listen_port={{ radixnode_p2p_listen_port }}
network.p2p.seed_nodes={{ radixnode_trusted_node }}
network.p2p.use_proxy_protocol={{ radixnode_use_proxy_protocol }}
network.host_ip={{ radixnode_host_ip }}

log.level=debug

api.port={{ radixnode_core_api_port }}
api.transactions.enable=true
api.sign.enable=true
api.bind.address=0.0.0.0

api.system.port={{ radixnode_system_api_port }}
api.system.bind_address=0.0.0.0

db.location={{ radixnode_data_dir }}
